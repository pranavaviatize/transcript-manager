# Copy this file to .env and fill in the values.
# .env is gitignored — never commit your real keys.

# OpenRouter API key for AI enrichment (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Model used for transcript analysis (any OpenRouter-supported chat model)
AI_MODEL=google/gemini-2.5-pro

# --- Chat / RAG (all optional; sensible defaults baked in) ---
# Embedding model + dimension used to index transcripts for semantic search.
# NOTE: changing the model/dim after indexing requires a full re-embed:
#   python -m app.scripts.reindex --force
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIM=1536
# Generation model for chat answers (blank = reuse AI_MODEL)
# CHAT_MODEL=
# Listwise reranker (set RERANK_ENABLED=false to skip the extra LLM call)
# RERANK_ENABLED=true
# RERANK_MODEL=google/gemini-2.5-flash
# RETRIEVAL_CANDIDATES=40
# RETRIEVAL_TOP_K=10

# Shared access key — required for the login screen. Leave blank to disable auth entirely.
AUTH_KEY=

# Random string used to sign session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If blank, a random one is generated at startup (you'll be logged out on every restart).
SESSION_SECRET=

# Local-only overrides (defaults are usually fine)
# DATABASE_URL=sqlite:///data/db.sqlite
# UPLOAD_DIR=data/transcripts
# APP_HOST=0.0.0.0
# APP_PORT=8000
